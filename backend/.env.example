# Gemini LLMs
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ORCHESTRATOR_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Tavily Search
TAVILY_API_KEY=your_tavily_api_key_here

# Zyte API (https://api.zyte.com/v1/extract)
# IMPORTANT: Use a Zyte API key from app.zyte.com API keys page.
# Do NOT use Scrapy Cloud project credentials here.
ZYTE_API_KEY=your_zyte_api_key_here

# Appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id_here
APPWRITE_API_KEY=your_appwrite_api_key_here
APPWRITE_DATABASE_ID=your_appwrite_database_id_here
APPWRITE_JOBS_COLLECTION_ID=jobs
APPWRITE_STYLES_COLLECTION_ID=styles
APPWRITE_BUCKET_ID=references

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=projectai-knowledge-base

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
